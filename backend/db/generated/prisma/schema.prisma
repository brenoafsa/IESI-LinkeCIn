// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
}

enum OpportunityTypes {
  EXTENSION
  COMPLEMENTARY
}

model User {
  id       String   @id @default(uuid())
  fullName String
  email    String   @unique
  password String
  role     UserRole

  studentRecord StudentRecord?

  publishedPosts    OpportunityPost[] @relation("Publisher")
  appliedPosts      OpportunityPost[] @relation("Candidates")
  savedPosts        OpportunityPost[] @relation("UserSavedPosts")
  participatedPosts OpportunityPost[] @relation("PostParticipants")
}

model StudentRecord {
  id        String @id @default(uuid())
  student   User   @relation(fields: [studentId], references: [id])
  studentId String @unique

  complementaryHours Int
  course             String
  entrance           String
  finishedSubjects   String[]
}

model OpportunityPost {
  id               String           @id @default(uuid())
  title            String
  description      String
  type             OpportunityTypes
  deadline         DateTime
  city             String
  state            String
  hours            Int
  requiredSubjects String[]
  isClosed         Boolean          @default(false)
  createdAt        DateTime         @default(now())

  publisher   User   @relation("Publisher", fields: [publisherId], references: [id])
  publisherId String

  candidates   User[] @relation("Candidates")
  savedBy      User[] @relation("UserSavedPosts")
  participants User[] @relation("PostParticipants")
}